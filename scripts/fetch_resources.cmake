function(fetch url dest)
    if(EXISTS "${dest}")
        message(STATUS "present: ${dest}")
        return()
    endif()
    message(STATUS "download: ${url}")
    file(DOWNLOAD "${url}" "${dest}.part" STATUS st TLS_VERIFY ON)
    list(GET st 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${dest}.part")
        message(FATAL_ERROR "download failed (${st}): ${url}")
    endif()
    file(RENAME "${dest}.part" "${dest}")
endfunction()

foreach(lang IN LISTS LANGS)
    if(DEFINED MODEL_${lang})
        fetch("${UDPIPE_BASE}/${MODEL_${lang}}-ud-2.5-191206.udpipe" "${ROOT}/data/udpipe/${lang}.udpipe")
    else()
        message(WARNING "no UDPipe model known for '${lang}'")
    endif()
    if(DEFINED DICT_${lang})
        fetch("${HUNSPELL_BASE}/${DICT_${lang}}.aff" "${ROOT}/data/hunspell/${lang}.aff")
        fetch("${HUNSPELL_BASE}/${DICT_${lang}}.dic" "${ROOT}/data/hunspell/${lang}.dic")
    endif()
endforeach()
